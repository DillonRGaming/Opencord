{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Opencord",
  "version": "0.1.0",
  "identifier": "monster.orbital.opencord",
  "build": {
    "frontendDist": "../shell"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb",
      "nsis"
    ],
    "category": "SocialNetworking",
    "shortDescription": "Chat with no limits",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libayatana-appindicator3-1"
        ]
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY4MjUwQ0JBRkQ0QjgzQkYKUldTL2cwdjl1Z3dsYUwydTZpV0RtT0pXMUl3WlYwYTN1Y3lJTlFwU0JxKytMdG5XZGxJSjVLNVYK",
      "endpoints": [
        "https://github.com/DillonRGaming/opencord-releases/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
